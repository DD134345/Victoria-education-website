---
// Homepage placeholder. The real homepage (section 6.6) is WEB-08.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublished } from '../lib/published';
import { site } from '../lib/site';

// Only human-approved entries are ever rendered (hard rule 1).
const news = (await getPublished('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout>
  <main>
    <h1>{site.name}</h1>
    <p>Website đang được xây dựng.</p>
    {news.length > 0 && (
      <section>
        <h2>Tin tức</h2>
        <ul>
          {news.map((n) => (
            <li>
              <strong>{n.data.title}</strong>
              <time datetime={n.data.date.toISOString()}>
                {n.data.date.toLocaleDateString('vi-VN')}
              </time>
              {n.data.summary && <p>{n.data.summary}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
