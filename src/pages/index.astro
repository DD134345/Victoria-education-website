---
// Homepage (restyle-B). Only approved content renders. Every section hides
// when empty in production. Dev preview: when import.meta.env.DEV is true AND
// a section has no real data, clearly-labelled "[Mẫu]" demo content from
// src/lib/demo.ts fills that section only (never in production builds).
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublished } from '../lib/published';
import { site, isPlaceholder } from '../lib/site';
import { isVisible, visibleRoutes } from '../lib/nav';
import { formatVnDate, parseVnDate } from '../lib/dates';
import { slug as slugify } from '../lib/slug';

import SectionTitle from '../components/SectionTitle.astro';
import Hero from '../components/Hero.astro';
import CardGrid from '../components/CardGrid.astro';
import NewsCard from '../components/NewsCard.astro';
import NoticeItem from '../components/NoticeItem.astro';
import FactsBand from '../components/FactsBand.astro';
import MethodCards from '../components/MethodCards.astro';
import ClassCard from '../components/ClassCard.astro';
import Timeline from '../components/Timeline.astro';
import MenuTable from '../components/MenuTable.astro';
import TestimonialTabs from '../components/TestimonialTabs.astro';
import AlbumTeaser from '../components/AlbumTeaser.astro';
import PartnerStrip from '../components/PartnerStrip.astro';
import FacilityStrip from '../components/FacilityStrip.astro';
import { photo, altFor, classKey } from '../lib/photos';

import siteFactsRaw from '../data/site-facts.json';
import dailyScheduleRaw from '../data/daily-schedule.json';
import classesRaw from '../data/classes.json';
import homeReasonsRaw from '../data/home-reasons.json';
import partnersRaw from '../data/partners.json';

// Demo preview data: DEV ONLY. The dynamic import sits inside a dead branch in
// production builds, so demo strings and SVG assets never reach dist/.
const demo = import.meta.env.DEV ? await import('../lib/demo') : null;

// Owner-filled JSON lists: [] or any "TODO-OWNER" value counts as empty.
const hasOwnerMarker = (v: unknown): boolean =>
  typeof v === 'string' ? v.includes('TODO-OWNER') : JSON.stringify(v).includes('TODO-OWNER');
const cleanList = <T,>(raw: unknown): T[] =>
  Array.isArray(raw) ? (raw as T[]).filter((item) => !hasOwnerMarker(item)) : [];

// News: dedupe by id + title, newest first, take 3. Adapt to NewsCard Props (slug derived, never invented facts).
const allNews = await getPublished('news');
const seenIds = new Set<string>();
const seenTitles = new Set<string>();
const news = [...allNews]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .filter((n) => {
    if (seenIds.has(n.id) || seenTitles.has(n.data.title)) return false;
    seenIds.add(n.id);
    seenTitles.add(n.data.title);
    return true;
  })
  .slice(0, 3)
  .map((entry) => ({
    data: {
      title: entry.data.title,
      date: entry.data.date,
      summary: entry.data.summary,
      category: entry.data.category,
      cover: entry.data.cover,
      cover_alt: entry.data.cover_alt,
      slug: slugify(entry.data.title) || entry.id.replace(/\.md$/, ''),
    },
  }));

// Notices: keep valid_until missing or >= today (Asia/Ho_Chi_Minh), newest first, take 3.
const todayStart = parseVnDate(formatVnDate(new Date())) ?? new Date();
const activeNotices = (await getPublished('notices'))
  .filter((n) => !n.data.valid_until || n.data.valid_until >= todayStart)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((entry) => ({
    data: {
      title: entry.data.title,
      date: entry.data.date,
      valid_until: entry.data.valid_until,
      summary: entry.data.summary,
      slug: slugify(entry.data.title) || entry.id.replace(/\.md$/, ''),
    },
  }));

// Testimonials: schema has ONLY author_label + body (no roles). Render only if >= 2 total,
// all under the "phu huynh" tab rather than inventing roles.
const allTestimonials = await getPublished('testimonials');
const parentTestimonials = allTestimonials
  .map((t) => ({ author_label: t.data.author_label, content: (t.body ?? '').trim() }))
  .filter((t) => t.author_label.trim() !== '' && t.content !== '');
const showTestimonials = parentTestimonials.length >= 2;

// Method cards: from the approved pages entry whose data.slug === 'phuong-phap'; H2s -> anchors.
const approvedPages = await getPublished('pages');
const phuongPhapPage = approvedPages.find((p) => {
  const s = p.data.slug.replace(/^\/|\/$/g, '');
  return s === 'phuong-phap' || s === 'giao-duc-tuyen-sinh/phuong-phap';
});
const methodHeadings = phuongPhapPage?.body
  ? [...phuongPhapPage.body.matchAll(/^##\s+(.+)$/gm)].map((m) => m[1].trim()).filter(Boolean)
  : [];
const methods = methodHeadings.map((title) => ({
  title,
  description: '',
  href: `/giao-duc-tuyen-sinh/phuong-phap/#${slugify(title)}`,
}));

// Menu of this week: latest approved menus entry by parsed week_start, hidden if unparseable.
const allMenus = await getPublished('menus');
const sortedMenus = [...allMenus].sort((a, b) => {
  const da = parseVnDate(a.data.week_start);
  const db = parseVnDate(b.data.week_start);
  return (db?.valueOf() ?? 0) - (da?.valueOf() ?? 0);
});
const latestMenu = sortedMenus[0] ?? null;
const latestWeekStart = latestMenu ? parseVnDate(latestMenu.data.week_start) : null;
const showMenu = !!latestMenu && !!latestWeekStart;

// Albums: 3 latest, hidden if 0 (no EmptyState on the public homepage).
const allAlbums = await getPublished('albums');
const showAlbums =
  [...allAlbums].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).length > 0;

// Owner data lists (hidden when empty).
const facts = cleanList<{ title: string; text: string }>(siteFactsRaw).filter((f) => f.title && f.text);
const reasons = cleanList<{ title: string; text: string; href?: string }>(homeReasonsRaw).filter(
  (r) => r.title && r.text,
);
const scheduleItems = cleanList<{ time: string; activity: string; description?: string }>(
  dailyScheduleRaw,
).filter((d) => d.time && d.activity);
// Classes: shape is owner-defined; keep rows with the fields ClassCard requires, take 3.
const classItems = cleanList<{
  ageGroup: string;
  className: string;
  teacherName: string;
  schedule: string;
  capacity: string;
  ctaHref?: string;
}>(classesRaw).filter((c) => c.ageGroup && c.className && c.teacherName && c.schedule && c.capacity);

// Demo fallbacks (DEV ONLY, per section, real data always wins).
const demoNews = demo && news.length === 0 ? demo.demoNews : [];
const demoNotices = demo && activeNotices.length === 0 ? demo.demoNotices : [];
const demoFacts = demo && facts.length === 0 ? demo.demoFacts : [];
const demoReasons = demo && reasons.length === 0 ? demo.demoReasons : [];
const demoMethods = demo && methods.length === 0 ? demo.demoMethods : [];
const demoSchedule = demo && scheduleItems.length === 0 ? demo.demoSchedule : [];
const demoTestimonials =
  demo && !showTestimonials
    ? { parents: demo.demoParentTestimonials, teachers: demo.demoTeacherTestimonials }
    : null;
const demoAlbumItems = demo && !showAlbums ? [{ ...demo.demoAlbum, href: null as string | null }] : [];
const demoPartners = demo ? demo.demoPartners : [];
// Real partners (hidden when empty; TODO-OWNER counts as missing).
const hasRealPartners =
  Array.isArray(partnersRaw) &&
  (partnersRaw as Array<{ name?: string; logo?: string; image?: unknown }>).some(
    (p) => p && p.name && (p.logo || p.image) && !hasOwnerMarker(p),
  );
const demoBadge = demo?.DEMO_BADGE ?? 'Nội dung mẫu';

// Hotline: TODO-OWNER counts as missing -> no "Gọi ngay" CTA anywhere.
const hotlineRaw = typeof site.hotline === 'string' ? site.hotline : '';
const hotline = isPlaceholder(hotlineRaw) ? '' : hotlineRaw.trim();
const hasHotline = hotline !== '';
const telHref = `tel:${hotline.replace(/\s+/g, '')}`;

// Registration CTA: /giao-duc-tuyen-sinh/dang-ky/ is only generated when an
// admissions form URL exists; otherwise fall back to /lien-he/ (same as Header).
const dangKyHref = (await isVisible('/giao-duc-tuyen-sinh/dang-ky/'))
  ? '/giao-duc-tuyen-sinh/dang-ky/'
  : '/lien-he/';
// "Xem tất cả" targets: only emit when the route is actually generated.
const routes = await visibleRoutes();
const tinTucVisible = routes['/tin-tuc/'] === true;
const thongBaoVisible = routes['/thong-bao/'] === true;
const phuongPhapVisible = routes['/giao-duc-tuyen-sinh/phuong-phap/'] === true;
// Owner-provided internal hrefs: drop them when the target route is not generated.
const safeHref = (href?: string): string | undefined => {
  if (!href) return undefined;
  if (!href.startsWith('/')) return href;
  const path = href.split('#')[0].split('?')[0];
  const key = (path.endsWith('/') ? path : `${path}/`) as keyof typeof routes;
  return routes[key] === true ? href : undefined;
};
---

<BaseLayout>
  <main>
    <!-- 1: Hero (only H1 on the page) -->
    <Hero
      headline={site.name}
      subtext="Thành viên Hệ thống Giáo dục Victoria"
      primaryCta={{ label: 'Đăng ký tham quan', href: dangKyHref }}
      {...(hasHotline ? { secondaryCta: { label: 'Gọi ngay', href: telHref } } : {})}
      background="gradient"
    />

    <!-- 2: reasons -->
    {(reasons.length > 0 || demoReasons.length > 0) && (
      <div class="home-block">
        <div class="container" data-reveal>
          {demoReasons.length > 0 && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <SectionTitle title="Vì sao chọn" accent="Newton" align="center" />
        </div>
        {reasons.length > 0 ? (
          <CardGrid
            cols={3}
            cards={reasons.map((r, i) => ({ title: r.title, description: r.text, href: safeHref(r.href), image: photo(`home-ly-do-${i + 1}`), imageAlt: altFor(`home-ly-do-${i + 1}`, r.title) }))}
          />
        ) : (
          <CardGrid
            cols={3}
            subheading={demo?.demoOverview}
            cards={demoReasons.map((r) => ({ title: r.title, description: r.text }))}
          />
        )}
      </div>
    )}

    {/* 2b: facility photos (assets/photos/co-so-vat-chat) */}
    <FacilityStrip />

    <!-- 3: news -->
    {(news.length > 0 || demoNews.length > 0) && (
      <section class="news-section home-section">
        <div class="container">
          {demoNews.length > 0 && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <div data-reveal>
            <SectionTitle title="Tin tức" accent="Sự kiện" align="center" />
          </div>
          <ul class="news-grid">
            {news.map((n, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms;`}>
                <NewsCard entry={n} />
              </li>
            ))}
            {demoNews.map((n, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms;`}>
                <NewsCard
                  entry={{
                    data: {
                      title: n.title,
                      date: n.date,
                      summary: n.summary,
                      category: n.category,
                      cover: n.cover,
                      cover_alt: n.coverAlt,
                      slug: 'minh-hoa',
                    },
                  }}
                  href={null}
                />
              </li>
            ))}
          </ul>
          <div class="more-row">
            {tinTucVisible && <a class="more-link" href="/tin-tuc/">Xem tất cả</a>}
          </div>
        </div>
      </section>
    )}

    <!-- 4: notices -->
    {(activeNotices.length > 0 || demoNotices.length > 0) && (
      <section class="notices-section home-section home-section--alt">
        <div class="container">
          {demoNotices.length > 0 && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <div data-reveal>
            <SectionTitle title="Thông báo" accent="mới nhất" align="center" />
          </div>
          <ul class="notices-list">
            {activeNotices.map((n, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms;`}>
                <NoticeItem entry={n} />
              </li>
            ))}
            {demoNotices.map((n, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms;`}>
                <NoticeItem
                  entry={{
                    data: { title: n.title, date: n.date, summary: n.summary, slug: 'minh-hoa' },
                  }}
                  href={null}
                />
              </li>
            ))}
          </ul>
          <div class="more-row">
            {thongBaoVisible && <a class="more-link" href="/thong-bao/">Xem tất cả</a>}
          </div>
        </div>
      </section>
    )}

    <!-- 5: facts -->
    {(facts.length > 0 || demoFacts.length > 0) && (
      <div data-reveal>
        {facts.length > 0 ? (
          <FactsBand facts={facts.map((f) => ({ value: f.title, label: f.text }))} />
        ) : (
          <div class="demo-band">
            <p class="demo-note demo-note--on-dark"><span>{demoBadge}</span></p>
            <FactsBand facts={demoFacts} />
          </div>
        )}
      </div>
    )}

    <!-- 6: MethodCards (only when the phuong-phap route is generated, or demo) -->
    {((methods.length > 0 && phuongPhapVisible) || demoMethods.length > 0) && (
      <div class="home-block">
        <div class="container" data-reveal>
          {demoMethods.length > 0 && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <SectionTitle title="Phương pháp" accent="giáo dục" align="center" />
        </div>
        {methods.length > 0 && phuongPhapVisible ? (
          <MethodCards methods={methods} />
        ) : (
          <MethodCards methods={demoMethods.map((m) => ({ title: m.title, description: m.description }))} />
        )}
      </div>
    )}

    <!-- 7: classes -->
    {classItems.length > 0 && (
      <section class="classes-section home-section">
        <div class="container">
          <div data-reveal>
            <SectionTitle title="Lớp học" accent="của bé" align="center" />
          </div>
          <div class="classes-grid">
            {classItems.slice(0, 3).map((c, i) => (
              <div data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms;`}>
                <ClassCard
                  ageGroup={c.ageGroup}
                  className={c.className}
                  teacherName={c.teacherName}
                  schedule={c.schedule}
                  capacity={c.capacity}
                  ctaHref={safeHref(c.ctaHref)}
                  classPhotoKey={classKey(c.className)}
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 8: daily schedule -->
    {(scheduleItems.length > 0 || demoSchedule.length > 0) && (
      <div class="home-block">
        <div class="container" data-reveal>
          {demoSchedule.length > 0 && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <SectionTitle title="Một ngày" accent="của bé" align="center" />
        </div>
        {scheduleItems.length > 0 ? (
          <Timeline
            layout="schedule"
            items={scheduleItems.map((d) => ({ date: d.time, title: d.activity, description: d.description }))}
          />
        ) : (
          <Timeline
            layout="schedule"
            items={demoSchedule.map((d) => ({ date: d.time, title: d.activity, description: d.description }))}
            images={demo?.demoScheduleImages ?? []}
          />
        )}
      </div>
    )}

    <!-- 9: weekly menu -->
    {showMenu && latestMenu && latestWeekStart && (
      <MenuTable weekStart={latestWeekStart} days={latestMenu.data.days} />
    )}

    <!-- 10: testimonials -->
    {(showTestimonials || demoTestimonials) && (
      <div class="home-block">
        <div class="container" data-reveal>
          {demoTestimonials && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <SectionTitle title="Cảm nhận" accent="yêu thương" align="center" />
        </div>
        {showTestimonials ? (
          <TestimonialTabs parents={parentTestimonials} teachers={[]} />
        ) : (
          demoTestimonials && (
            <TestimonialTabs
              parents={demoTestimonials.parents.map((t) => ({
                author_label: t.authorLabel,
                content: t.content,
                avatar: t.avatar,
              }))}
              teachers={demoTestimonials.teachers.map((t) => ({
                author_label: t.authorLabel,
                content: t.content,
                avatar: t.avatar,
              }))}
            />
          )
        )}
      </div>
    )}

    <!-- 11: albums -->
    {(showAlbums || demoAlbumItems.length > 0) && (
      <div class="home-block">
        <div class="container" data-reveal>
          {demoAlbumItems.length > 0 && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <SectionTitle title="Thư viện" accent="hình ảnh" align="center" />
        </div>
        {showAlbums ? (
          <AlbumTeaser limit={3} />
        ) : (
          <AlbumTeaser limit={3} viewAllHref="" demoItems={demoAlbumItems} />
        )}
      </div>
    )}

    <!-- 12: partners (hidden when partners.json is empty; demo in dev) -->
    {(hasRealPartners || demoPartners.length > 0) && (
      <div class="home-block">
        <div class="container" data-reveal>
          {demoPartners.length > 0 && !hasRealPartners && (
            <p class="demo-note"><span>{demoBadge}</span></p>
          )}
          <SectionTitle title="Đơn vị" accent="đồng hành" align="center" />
        </div>
        {hasRealPartners ? (
          <PartnerStrip />
        ) : (
          <PartnerStrip partners={demoPartners.map((p) => ({ name: p.name, image: p.image }))} />
        )}
      </div>
    )}

    <!-- 13: CTA band -->
    <section class="cta-band" aria-labelledby="cta-band-heading">
      <div class="container" data-reveal>
        <h2 id="cta-band-heading">Đặt lịch tham quan trường</h2>
        <p class="cta-band__text">Mời ba mẹ đến thăm không gian học tập của các bé.</p>
        <div class="cta-band__actions">
          <a class="cta-band__btn cta-band__btn--primary" href={dangKyHref}>
            Đăng ký tham quan
          </a>
          {hasHotline && (
            <a class="cta-band__btn cta-band__btn--ghost" href={telHref}>
              Gọi ngay
            </a>
          )}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Homepage rhythm: components own their padding; wrappers only separate blocks. */
  .home-block { padding: var(--space-4) 0; }
  .home-block:first-of-type { padding-top: var(--space-8); }
  .home-section { padding: var(--space-12) 0; }
  .home-section--alt { background: var(--surface-alt); }

  /* Dev-preview badge: visible "Nội dung mẫu" marker on each demo section. */
  .demo-note { text-align: center; margin: 0 0 var(--space-4); }
  .demo-note span {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent-strong);
    border-radius: var(--radius-pill);
    padding: var(--space-2) var(--space-5);
    min-height: var(--tap);
    line-height: calc(var(--tap) - 2 * var(--space-2));
  }
  .demo-band { position: relative; }
  .demo-band .demo-note--on-dark {
    position: absolute;
    top: var(--space-5);
    left: 0;
    right: 0;
    z-index: 2;
  }
  .demo-band .facts { padding-top: calc(var(--space-16) + var(--space-8)); }

  .news-grid {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .news-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .news-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .notices-list {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .notices-list { grid-template-columns: repeat(3, 1fr); }
  }
  .classes-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
    margin-top: var(--space-8);
  }
  @media (min-width: 768px) {
    .classes-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .classes-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .more-row { margin-top: var(--space-8); text-align: center; }
  .more-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-6);
    border-radius: var(--radius-pill);
    border: 2px solid var(--brand);
    color: var(--brand-ink);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .more-link:hover { background: var(--brand); color: #fff; transform: translateY(-2px); }

  /* CTA band: green-to-pink gradient, white Baloo 2 heading, pill buttons. */
  .cta-band {
    position: relative;
    overflow: clip;
    text-align: center;
    padding: var(--space-16) var(--space-4);
    background:
      radial-gradient(30rem 16rem at 90% 110%, rgb(255 90 90 / 0.4) 0%, transparent 60%),
      linear-gradient(140deg, var(--brand-ink) 0%, var(--brand) 70%);
  }
  .cta-band h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: #fff;
    margin: 0 0 var(--space-2);
  }
  .cta-band__text { color: rgb(255 255 255 / 0.92); margin: 0 0 var(--space-6); }
  .cta-band__actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-band__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .cta-band__btn:active { transform: scale(0.98); }
  .cta-band__btn--primary { background: #fff; color: var(--brand-ink); }
  .cta-band__btn--primary:hover { transform: translateY(-2px); background: var(--brand-soft); color: var(--brand-ink); }
  .cta-band__btn--ghost { border: 2px solid rgb(255 255 255 / 0.85); color: #fff; }
  .cta-band__btn--ghost:hover { background: rgb(255 255 255 / 0.16); transform: translateY(-2px); color: #fff; }

  /* Scroll-reveal: hidden ONLY when <html class="js"> (set by BaseLayout).
     Content is fully visible when JS is off. */
  :global(html.js [data-reveal]) {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  :global(html.js [data-reveal].is-visible) {
