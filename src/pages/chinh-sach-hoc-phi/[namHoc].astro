---
// Past school years' fee tables (WEB-09). Generated only when >= 2 approved fee
// files exist; the newest one lives on /chinh-sach-hoc-phi/ itself.
import PageLayout from '../../layouts/PageLayout.astro';
import FeeTable from '../../components/FeeTable.astro';
import { getFees, feeTableProps } from '../../lib/fees';

export async function getStaticPaths() {
  return (await getFees()).slice(1).map((entry) => ({ params: { namHoc: entry.data.school_year }, props: { entry } }));
}
const { entry } = Astro.props;
---
<PageLayout title={`Học phí năm học ${entry.data.school_year}`} eyebrow="Chính sách học phí">
  <FeeTable {...feeTableProps(entry)} isPast />
  <p class="back"><a class="btn btn--outline" href="/chinh-sach-hoc-phi/">← Học phí năm học hiện tại</a></p>
</PageLayout>

<style>
  .back { margin-top: var(--space-10); }
</style>
