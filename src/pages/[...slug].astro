---
// Text pages from the `pages` collection (Google Docs via DS). Only approved pages
// on the allow-list in lib/nav.ts are generated (section 6.3).
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { getPublished } from '../lib/published';
import { PAGE_ROUTES } from '../lib/nav';

export async function getStaticPaths() {
  const allowed = new Set<string>(PAGE_ROUTES);
  return (await getPublished('pages'))
    .map((entry) => ({ entry, slug: entry.data.slug.replace(/^\/|\/$/g, '') }))
    .filter(({ slug }) => allowed.has(slug))
    .map(({ entry, slug }) => ({ params: { slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<PageLayout title={entry.data.title} description={entry.data.description}>
  <Content />
</PageLayout>
