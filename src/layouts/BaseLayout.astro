---
// Single HTML shell for every page (fixes X11: no duplicated <html> per page).
import { isIndexable } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import '../styles/global.css';
import { canonical, pageTitle, DEFAULT_DESCRIPTION } from '../lib/seo';
import { site as school, isReal, addressText, hasStreetAddress, hoursText } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  lang?: 'vi' | 'en';
}

const { title, description = DEFAULT_DESCRIPTION, lang = 'vi' } = Astro.props;
const canonicalURL = canonical(Astro.url.pathname, Astro.site);
const fullTitle = pageTitle(title);
const ogImage = new URL('/og-default.jpg', Astro.site ?? 'http://localhost:4321').toString();
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

// JSON-LD (section 6.9): only facts that are real in site-config.json.
const org: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['Preschool', 'EducationalOrganization'],
  name: school.name,
  url: new URL('/', Astro.site ?? 'http://localhost:4321').toString(),
  logo: new URL('/icon-512.png', Astro.site ?? 'http://localhost:4321').toString(),
};
if (isReal(school.hotline)) org.telephone = school.hotline;
if (isReal(school.email)) org.email = school.email;
if (hasStreetAddress) org.address = { '@type': 'PostalAddress', streetAddress: addressText, addressCountry: 'VN' };
if (hoursText) org.openingHours = `Mo-Fr ${hoursText.replace(' – ', '-')}`;
if (isReal(school.parentOrganization)) org.parentOrganization = { '@type': 'Organization', name: school.parentOrganization };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {!isIndexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${school.name} – Tin tức`} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#536501" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'vi_VN'} />
    <meta property="og:site_name" content={school.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <Header />
    <div id="main" class="page"><slot /></div>
    <Footer />
    <MobileActionBar />
    {cfToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>
    )}
    <script is:inline>(function(){try{var els=document.querySelectorAll('[data-reveal]');var vh=window.innerHeight||800;var io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting||e.boundingClientRect.bottom<0){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:[0,0.12],rootMargin:'0px 0px -6% 0px'}):null;var pending=[];for(var i=0;i<els.length;i++){var el=els[i];/* Already on screen at load: show at once, no fade (keeps LCP fast). */if(!io||el.getBoundingClientRect().top<vh){el.classList.add('is-visible','reveal-now');}else{io.observe(el);pending.push(el);}}if(io&&pending.length){var rafId=0;function onScroll(){if(rafId) return;rafId=requestAnimationFrame(function(){rafId=0;var h=window.innerHeight,due=[],keep=[],j;/* read all positions first, then write (no layout thrash) */for(j=0;j<pending.length;j++){(pending[j].getBoundingClientRect().top<h?due:keep).push(pending[j]);}pending=keep;for(j=0;j<due.length;j++){due[j].classList.add('is-visible');io.unobserve(due[j]);}if(pending.length===0){window.removeEventListener('scroll',onScroll,{passive:true});}});}window.addEventListener('scroll',onScroll,{passive:true});}}catch(e){var all=document.querySelectorAll('[data-reveal]');for(var k=0;k<all.length;k++){all[k].classList.add('is-visible');}}})();</script>
  </body>
</html>
