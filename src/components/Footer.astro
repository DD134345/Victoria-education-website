---
// Footer (restyle-A). Pink wave divider on top (own inline SVG), deep-green
// body, school name in Baloo 2, contact lines with icons, quick-links
// column, and our own small cloud/star/apple doodles. Facts come ONLY from
// site-config.json; placeholders and empty values hide their lines.
import { site, isPlaceholder } from '../lib/site';
import { isVisible } from '../lib/nav';

const show = (v: unknown) => typeof v === 'string' && v.trim() !== '' && !isPlaceholder(v);

// Address may be an object {street, ward, district, city}: join the real parts.
const addrRaw: unknown = site.address;
const addrText =
  addrRaw && typeof addrRaw === 'object'
    ? Object.values(addrRaw as Record<string, unknown>)
        .filter((p) => typeof p === 'string' && (p as string).trim() !== '' && !isPlaceholder(p))
        .join(', ')
    : show(addrRaw)
      ? String(addrRaw)
      : '';

// Hours may be an object {start, end}: render the owner-provided range.
const hoursRaw: unknown = site.hours;
const hoursText =
  hoursRaw && typeof hoursRaw === 'object'
    ? (() => {
        const h = hoursRaw as Record<string, unknown>;
        return show(h.start) && show(h.end) ? `${h.start} – ${h.end}` : '';
      })()
    : show(hoursRaw)
      ? String(hoursRaw)
      : '';

const telHref = show(site.hotline) ? `tel:${String(site.hotline).replace(/[^\d+]/g, '')}` : '';
const privacy = await isVisible('/chinh-sach-bao-mat/');
const year = new Date().getFullYear();
---
<div class="footer-wave" aria-hidden="true">
  <svg viewBox="0 0 1440 90" preserveAspectRatio="none" focusable="false">
    <path class="footer-wave__back" d="M0 52 C 240 88 480 12 720 40 C 960 68 1200 22 1440 52 L1440 90 L0 90 Z" />
    <path class="footer-wave__front" d="M0 64 C 260 94 520 32 760 54 C 1000 76 1220 42 1440 64 L1440 90 L0 90 Z" />
  </svg>
</div>
<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <p class="name">{site.name}</p>
      <p class="badge">Thành viên Hệ thống Giáo dục Victoria</p>
      <svg class="doodle" viewBox="0 0 200 64" aria-hidden="true" focusable="false">
        <g fill="#ffffff" opacity="0.85">
          <ellipse cx="34" cy="40" rx="18" ry="9" />
          <ellipse cx="48" cy="34" rx="14" ry="10" />
          <ellipse cx="22" cy="35" rx="10" ry="7" />
        </g>
        <g fill="none" stroke="var(--accent-soft)" stroke-width="2" stroke-linecap="round">
          <path d="M120 14 l2.2 5.2 5.2 2.2 -5.2 2.2 -2.2 5.2 -2.2 -5.2 -5.2 -2.2 5.2 -2.2 Z" fill="var(--accent-soft)" stroke="none" />
          <path d="M158 34 l1.6 3.8 3.8 1.6 -3.8 1.6 -1.6 3.8 -1.6 -3.8 -3.8 -1.6 3.8 -1.6 Z" fill="var(--accent-soft)" stroke="none" />
        </g>
        <g>
          <circle cx="88" cy="40" r="12" fill="var(--apple)" />
          <path d="M88 28 C 88 22 92 20 96 20" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
          <path d="M96 20 C 100 14 106 14 108 18 C 104 22 100 22 96 20 Z" fill="var(--brand-tint)" />
        </g>
      </svg>
    </div>
    <div>
      <p class="col-title">Liên hệ</p>
      <ul class="contact">
        {addrText && (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{addrText}</span>
          </li>
        )}
        {show(site.hotline) && (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2.1L8.1 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.9 2Z"></path>
            </svg>
            <a href={telHref}>{site.hotline}</a>
          </li>
        )}
        {show(site.email) && (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true" focusable="false">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="M3 7l9 6 9-6"></path>
            </svg>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        )}
        {hoursText && (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            <span>Giờ: {hoursText}</span>
          </li>
        )}
      </ul>
    </div>
    <div>
      <p class="col-title">Liên kết nhanh</p>
      <ul class="links">
        <li><a href="/cong-khai/">Công khai thông tin</a></li>
        <li><a href="/lien-he/">Liên hệ</a></li>
        {privacy && <li><a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a></li>}
      </ul>
    </div>
  </div>
  <p class="container copy">© {year} {site.name}</p>
</footer>

<style>
  .footer-wave { line-height: 0; margin-top: var(--space-16); }
  .footer-wave svg { display: block; width: 100%; height: clamp(44px, 7vw, 88px); }
  .footer-wave__back { fill: var(--accent-soft); }
  .footer-wave__front { fill: var(--accent); }

  .site-footer { background: var(--brand-ink); color: #fff; padding: var(--space-10) 0 var(--space-6); }
  .grid { display: grid; gap: var(--space-8); }
  .name { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 700; line-height: 1.3; margin: 0 0 var(--space-3); color: #fff; }
  .badge {
    display: inline-block;
    border: 2px solid var(--apple);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
    color: #fff;
  }
  .doodle { display: block; width: 200px; max-width: 100%; height: auto; margin-top: var(--space-5); }
  .col-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: #fff;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--accent);
    display: inline-block;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .contact li { display: flex; align-items: flex-start; gap: var(--space-2); }
  .contact svg { flex-shrink: 0; margin-top: 0.2em; color: var(--brand-tint); }
  .contact span { overflow-wrap: anywhere; }
  a { color: #fff; text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  a:hover { color: var(--brand-tint); }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-weight: 500;
  }
  .links a:hover { text-decoration: underline; }
  .copy {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(255 255 255 / 0.2);
    font-size: var(--text-sm);
    color: var(--brand-tint);
  }
  @media (min-width: 768px) {
    .grid { grid-template-columns: 2fr 2fr 1fr; align-items: start; }
  }
  @media (min-width: 1100px) {
    .doodle { animation: footer-float 9s ease-in-out infinite; }
  }
  @keyframes footer-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .doodle { animation: none; }
  }
</style>
