---
// Prose component (WEB-07b, fixed in WEB-09). Rich-text wrapper for Markdown
// page/news/notice bodies: Baloo 2 headings, Be Vietnam Pro body.
// Content arrives through the default <slot /> (a `children` prop is never
// populated in Astro), and every descendant rule is :global() because the
// rendered Markdown does not carry this component's scoped-style attribute.
interface Props {
  /** Wrapper class */
  class?: string;
  /** Base heading level (h2 by default, since h1 is page title) */
  baseLevel?: 2 | 3;
}

const { class: wrapperClass = '', baseLevel = 2 } = Astro.props;
---

<div class:list={['prose', wrapperClass]} data-base-level={baseLevel}>
  <slot />
</div>

<style>
  .prose {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading);
    color: var(--ink);
    max-width: 68ch;
  }

  /* Headings */
  .prose :global(h2), .prose :global(h3), .prose :global(h4) {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--brand-ink);
    margin: var(--space-8) 0 var(--space-4);
    text-wrap: balance;
  }
  .prose :global(h2) { font-size: var(--text-2xl); }
  .prose :global(h3) { font-size: var(--text-xl); font-weight: 600; }
  .prose :global(h4) { font-size: var(--text-lg); font-weight: 600; }

  /* Adjust if baseLevel is 3 */
  .prose[data-base-level="3"] :global(h2) { font-size: var(--text-xl); }
  .prose[data-base-level="3"] :global(h3) { font-size: var(--text-lg); }

  /* Paragraphs */
  .prose :global(p) { margin: 0 0 var(--space-4); }
  .prose :global(p:last-child) { margin-bottom: 0; }

  /* Links */
  .prose :global(a) {
    color: var(--brand);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 2px;
    transition: color 0.2s ease;
  }
  .prose :global(a:hover) { color: var(--brand-ink); }

  /* Text emphasis */
  .prose :global(strong) { font-weight: 700; color: var(--ink); }
  .prose :global(em) { font-style: italic; }
  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    background: var(--brand-tint);
    padding: 0.125em 0.375em;
    border-radius: var(--radius-sm);
  }
  .prose :global(pre) {
    background: var(--brand-ink);
    color: var(--brand-tint);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: var(--space-4) 0;
  }
  .prose :global(pre code) { background: none; padding: 0; font-size: var(--text-sm); line-height: 1.5; }

  /* Lists */
  .prose :global(ul), .prose :global(ol) { margin: var(--space-4) 0; padding-left: var(--space-6); }
  .prose :global(li) { margin: var(--space-2) 0; }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(ul ul), .prose :global(ol ol), .prose :global(ul ol), .prose :global(ol ul) { margin: var(--space-2) 0; }

  /* Blockquotes */
  .prose :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    border-left: 4px solid var(--accent-strong);
    background: var(--accent-soft);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--accent-ink);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(blockquote cite) {
    display: block;
    margin-top: var(--space-3);
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Tables */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: var(--text-sm);
  }
  .prose :global(th), .prose :global(td) {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--brand-tint);
    text-align: left;
  }
  .prose :global(th) {
    background: var(--brand-soft);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--brand-ink);
  }
  .prose :global(tr:nth-child(even) td) { background: var(--surface-alt); }
  .prose :global(caption) {
    caption-side: bottom;
    padding: var(--space-2);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* Images */
  .prose :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); margin: var(--space-4) 0; }
  .prose :global(figure) { margin: var(--space-6) 0; }
  .prose :global(figcaption) {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--muted);
    margin-top: var(--space-2);
  }

  /* Horizontal rule */
  .prose :global(hr) {
    border: none;
    border-top: 2px solid var(--brand-tint);
    margin: var(--space-8) 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
  .prose :global(h2) { font-size: var(--text-xl); }
  .prose :global(h3) { font-size: var(--text-lg); }
  .prose :global(h4) { font-size: var(--text-base); }
  }
</style>