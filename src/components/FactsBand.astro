---
// FactsBand component (restyle-B, NEW). Stats band: full-width gradient band
// with frosted-glass cards holding big numbers. Text pairs use white on brand
// tones (WCAG AA verified). Frosted cards fall back to a solid wash where
// backdrop-filter is unsupported. Renders nothing when facts is empty.
interface Fact {
  /** Big display value (e.g. "12", "2.000m²") */
  value: string;
  /** Label under the number */
  label: string;
}

interface Props {
  facts: Fact[];
  /** Eyebrow label */
  eyebrow?: string;
  /** Anchor id for the section */
  id?: string;
}

const { facts, eyebrow, id } = Astro.props;
---

{facts.length > 0 && (
  <section class="facts" aria-label="Con số nổi bật" {...(id ? { id } : {})}>
    <svg class="facts__doodle facts__doodle--a" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <path d="M20 100 C 35 55 70 30 105 25 C 100 65 70 95 20 100 Z" />
    </svg>
    <svg class="facts__doodle facts__doodle--b" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
      <circle cx="60" cy="38" r="14" />
      <circle cx="82" cy="60" r="14" />
      <circle cx="60" cy="82" r="14" />
      <circle cx="38" cy="60" r="14" />
      <circle cx="60" cy="60" r="11" />
    </svg>
    <div class="container">
      {eyebrow && <p class="facts__eyebrow">{eyebrow}</p>}
      <ul class="facts__list">
        {facts.map((fact, i) => (
          <li class="facts__item" data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms;`}>
            <span class="facts__value">{fact.value}</span>
            <span class="facts__label">{fact.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .facts {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding: var(--space-16) 0;
    background:
      radial-gradient(38rem 20rem at 88% 12%, rgb(255 90 90 / 0.35) 0%, transparent 60%),
      linear-gradient(140deg, var(--brand-ink) 0%, var(--brand) 68%, #6d7f0a 100%);
  }
  .facts__doodle {
    position: absolute;
    z-index: 0;
    fill: rgb(255 255 255 / 0.14);
    pointer-events: none;
  }
  .facts__doodle--a { width: clamp(90px, 14vw, 150px); left: 3%; top: 8%; transform: rotate(-12deg); }
  .facts__doodle--b { width: clamp(70px, 10vw, 110px); right: 5%; bottom: 10%; }
  .facts .container { position: relative; z-index: 1; }
  .facts__eyebrow {
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 var(--space-6);
  }
  .facts__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    .facts__list { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  }
  .facts__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-8) var(--space-5);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.38);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 10px 30px rgb(0 0 0 / 0.18);
  }
  @supports (backdrop-filter: blur(1px)) {
    .facts__item {
      background: rgb(255 255 255 / 0.14);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .facts__item { background: rgb(59 74 0 / 0.72); }
  }
  .facts__value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.5rem, 2rem + 3vw, 3.5rem);
    line-height: 1.1;
    color: #fff;
  }
  .facts__label {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: #fff;
    max-width: 24ch;
  }
  @media (prefers-reduced-motion: no-preference) {
    .facts__doodle--a { animation: facts-float 9s ease-in-out infinite; }
    .facts__doodle--b { animation: facts-float 7s ease-in-out -3s infinite; }
  }
  @keyframes facts-float {
    0%, 100% { transform: translateY(0) rotate(-12deg); }
    50% { transform: translateY(-10px) rotate(-8deg); }
  }
</style>
