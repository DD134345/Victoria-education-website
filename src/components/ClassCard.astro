---
// ClassCard component (WEB-07b). For "Các lớp học" section.
// Shows: age group, class name, teacher, schedule, capacity, CTA.
// Crops teacher photo to 4:5 per spec §6.7. Mobile-first, soft rounded.
import { Image } from 'astro:assets';
import PhotoFrame from './PhotoFrame.astro';
import { hasPhoto } from '../lib/photos';

interface Props {
  /** Age group label, e.g. "3 tuổi", "4 tuổi", "5 tuổi" */
  ageGroup: string;
  /** Class name, e.g. "Lớp Hoa Mai" */
  className: string;
  /** Teacher name */
  teacherName: string;
  /** Teacher photo (4:5 portrait, ≥1200px tall per spec) */
  teacherPhoto?: ImageMetadata;
  /** Teacher photo alt */
  teacherPhotoAlt?: string;
  /** Schedule summary, e.g. "Thứ 2–6: 7:30–17:00" */
  schedule: string;
  /** Capacity, e.g. "20 bé / lớp" */
  capacity: string;
  /** Monthly fee (formatted with "đ") */
  fee?: string;
  /** CTA link to registration */
  ctaHref?: string;
  /** CTA label */
  ctaLabel?: string;
  /** Photo slot for the class (src/assets/photos/lop-hoc/<class>.jpg) */
  classPhotoKey?: string;
  /** Accent color variant for the age badge */
  accentVariant?: 'brand' | 'accent' | 'apple';
}

const {
  ageGroup,
  className,
  teacherName,
  teacherPhoto,
  teacherPhotoAlt = `Giáo viên ${teacherName}`,
  schedule,
  capacity,
  fee,
  ctaHref,
  ctaLabel = 'Đăng ký tham quan',
  accentVariant = 'brand',
  classPhotoKey,
} = Astro.props;
const showClassPhoto = !!classPhotoKey && (hasPhoto(classPhotoKey) || import.meta.env.DEV);

const accentMap = {
  brand: 'var(--brand)',
  accent: 'var(--accent-strong)',
  apple: 'var(--apple)',
};
const accentColor = accentMap[accentVariant];
---

<article class="class-card" style="--accent: {accentColor};">
  {showClassPhoto && (
    <PhotoFrame photoKey={classPhotoKey} alt={`Lớp ${className}`} shape="rounded" ratio="16 / 10" decorate={false}
      tone={accentVariant === 'accent' ? 'pink' : 'green'} sizes="(min-width: 1024px) 33vw, 100vw" class="class-card__photo" />
  )}
  <header class="class-card__header">
    <span class="class-card__age-badge">{ageGroup}</span>
    <h3 class="class-card__class-name">{className}</h3>
  </header>

  <div class="class-card__body">
    {teacherPhoto && (
      <div class="class-card__teacher-photo">
        <Image src={teacherPhoto} alt={teacherPhotoAlt} width={320} height={400} loading="lazy" />
      </div>
    )}
    <div class="class-card__teacher">
      <span class="class-card__teacher-label">Giáo viên chủ nhiệm</span>
      <p class="class-card__teacher-name">{teacherName}</p>
    </div>
  </div>

  <ul class="class-card__details">
    <li class="class-card__detail">
      <svg class="class-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span>{schedule}</span>
    </li>
    <li class="class-card__detail">
      <svg class="class-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <span>{capacity}</span>
    </li>
    {fee && (
      <li class="class-card__detail class-card__detail--fee">
        <svg class="class-card__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
        <span class="class-card__fee">{fee}</span>
      </li>
    )}
  </ul>

  {ctaHref && (
    <a class="class-card__cta" href={ctaHref}>{ctaLabel}</a>
  )}
</article>

<style>
  .class-card :global(.class-card__photo .pf__frame) { border-radius: 0; box-shadow: none; }
  .class-card {
    background: var(--surface);
    border: 1px solid var(--brand-tint);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .class-card:hover {
    box-shadow: var(--shadow);
    border-color: var(--brand);
  }

  .class-card__header {
    padding: var(--space-4) var(--space-4) var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .class-card__age-badge {
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
  }
  .class-card__class-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--brand-ink);
    margin: 0;
  }

  .class-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4) var(--space-4);
  }
  @media (min-width: 600px) {
    .class-card__body { flex-direction: row; align-items: flex-start; }
  }

  .class-card__teacher-photo {
    width: 100%;
    max-width: 160px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--brand-soft);
    flex-shrink: 0;
  }
  .class-card__teacher-photo img { width: 100%; height: 100%; object-fit: cover; }

  .class-card__teacher { text-align: center; flex: 1; }
  @media (min-width: 600px) { .class-card__teacher { text-align: left; } }
  .class-card__teacher-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-1);
  }
  .class-card__teacher-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }

  .class-card__details {
    list-style: none;
    margin: 0;
    padding: var(--space-4);
    border-top: 1px solid var(--brand-tint);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  @media (min-width: 600px) {
    .class-card__details { flex-direction: row; flex-wrap: wrap; justify-content: space-around; }
  }

  .class-card__detail {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    color: var(--ink);
    flex: 1;
    min-width: 0;
  }
  .class-card__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--brand);
  }
  .class-card__detail--fee .class-card__fee {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--accent-strong);
    font-size: var(--text-base);
  }

  .class-card__cta {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--accent-strong);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    min-height: var(--tap);
    transition: background-color 0.2s ease, transform 0.1s ease;
  }
  .class-card__cta:hover { background: var(--accent-ink); color: #fff; }
  .class-card__cta:active { transform: scale(0.98); }

  @media (prefers-reduced-motion: reduce) {
    .class-card, .class-card__cta { transition: none; }
  }
</style>