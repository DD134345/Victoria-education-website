---
// Gallery component (restyle-B). For album detail pages.
// Lazy loading, keyboard-accessible lightbox, no external library (vanilla JS).
// Images via astro:assets. Rounded 22px cards with hover lift.
import { Image } from 'astro:assets';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  /** Album title */
  title: string;
  /** Album date */
  date: Date;
  /** Album category */
  category: 'co-so-vat-chat' | 'hinh-anh-cac-be';
  /** Gallery images */
  images: GalleryImage[];
  /** Consent register reference (for child photos) */
  consentRegisterRef?: string;
  /** Heading level: h2 when several albums share a page (PageLayout owns the h1) */
  as?: 'h1' | 'h2';
}

import { formatVnDate } from '../lib/dates';
const { title, date, category, images, consentRegisterRef, as: Heading = 'h2' } = Astro.props;

const categoryLabels = {
  'co-so-vat-chat': 'Cơ sở vật chất',
  'hinh-anh-cac-be': 'Hình ảnh các bé',
};
const galleryId = `gallery-${Math.random().toString(36).slice(2, 8)}`;
---

<article class="gallery" aria-labelledby={`${galleryId}-title`} id={galleryId}>
  <header class="gallery__header">
    <div class="gallery__meta">
      <span class={`gallery__category gallery__category--${category}`}>
        {categoryLabels[category]}
      </span>
      <time class="gallery__date" datetime={date.toISOString()}>
        {formatVnDate(date)}
      </time>
    </div>
    <Heading id={`${galleryId}-title`} class="gallery__title">{title}</Heading>
    {consentRegisterRef && (
      <p class="gallery__consent">
        Đã kiểm tra đồng ý ảnh: {consentRegisterRef}
      </p>
    )}
  </header>

  <div class="gallery__grid" role="list" aria-label={`${images.length} ảnh trong album`}>
    {images.map((image, index) => (
      <figure class="gallery__item" role="listitem" data-reveal style={`--reveal-delay: ${(index % 3) * 90}ms;`}>
        <button
          class="gallery__trigger"
          type="button"
          data-index={index}
          aria-label={`Mở ảnh ${index + 1} của ${images.length}: ${image.alt}`}
          aria-haspopup="dialog"
        >
          <Image src={image.src} alt={image.alt} loading="lazy" />
        </button>
        <figcaption class="gallery__caption">{image.alt}</figcaption>
      </figure>
    ))}
  </div>
</article>

<!-- Lightbox (hidden by default, shown via JS) -->
<div class="gallery__lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Xem ảnh phóng to">
  <button class="gallery__close" type="button" aria-label="Đóng">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="26" height="26">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <button class="gallery__nav gallery__nav--prev" type="button" data-lightbox-prev aria-label="Ảnh trước">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="26" height="26">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button class="gallery__nav gallery__nav--next" type="button" data-lightbox-next aria-label="Ảnh sau">
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="26" height="26">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>
  <div class="gallery__lightbox-inner">
    <img class="gallery__lightbox-img" alt="" />
    <p class="gallery__lightbox-caption"></p>
    <p class="gallery__lightbox-counter"></p>
  </div>
</div>

<script is:inline define:vars={{ galleryId }}>
  // Vanilla JS lightbox - no external library, scoped per gallery instance.
  (function () {
    var root = document.getElementById(galleryId);
    if (!root) return;
    var triggers = Array.prototype.slice.call(root.querySelectorAll('.gallery__trigger'));
    var lightbox = root.nextElementSibling;
    if (!lightbox || !lightbox.hasAttribute('data-lightbox')) {
      lightbox = document.querySelector('#' + galleryId + ' + [data-lightbox]');
    }
    if (!triggers.length || !lightbox) return;
    var lightboxImg = lightbox.querySelector('.gallery__lightbox-img');
    var lightboxCaption = lightbox.querySelector('.gallery__lightbox-caption');
    var lightboxCounter = lightbox.querySelector('.gallery__lightbox-counter');
    var closeBtn = lightbox.querySelector('.gallery__close');
    var prevBtn = lightbox.querySelector('[data-lightbox-prev]');
    var nextBtn = lightbox.querySelector('[data-lightbox-next]');
    if (!lightboxImg || !closeBtn || !prevBtn || !nextBtn) return;

    var imagesData = triggers.map(function (trigger) {
      var img = trigger.querySelector('img');
      return {
        src: img ? img.currentSrc || img.src : '',
        alt: img ? img.alt : '',
        caption: trigger.nextElementSibling ? trigger.nextElementSibling.textContent : '',
      };
    });

    var currentIndex = 0;
    var focusBeforeOpen = null;

    function openLightbox(index) {
      currentIndex = index;
      focusBeforeOpen = document.activeElement;
      updateLightbox();
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
      document.addEventListener('keydown', handleKeydown);
    }

    function closeLightbox() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      document.removeEventListener('keydown', handleKeydown);
      if (focusBeforeOpen && focusBeforeOpen.focus) focusBeforeOpen.focus();
    }

    function updateLightbox() {
      var data = imagesData[currentIndex];
      lightboxImg.src = data.src;
      lightboxImg.alt = data.alt;
      if (lightboxCaption) lightboxCaption.textContent = data.caption;
      if (lightboxCounter) lightboxCounter.textContent = (currentIndex + 1) + ' / ' + imagesData.length;
    }

    function showPrev() {
      currentIndex = (currentIndex - 1 + imagesData.length) % imagesData.length;
      updateLightbox();
    }

    function showNext() {
      currentIndex = (currentIndex + 1) % imagesData.length;
      updateLightbox();
    }

    function handleKeydown(e) {
      if (e.key === 'Escape') { closeLightbox(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); showPrev(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); showNext(); }
      else if (e.key === 'Tab') {
        var focusable = lightbox.querySelectorAll('button');
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      }
    }

    triggers.forEach(function (trigger, i) {
      trigger.addEventListener('click', function () { openLightbox(i); });
    });

    closeBtn.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', showPrev);
    nextBtn.addEventListener('click', showNext);

    lightbox.addEventListener('click', function (e) {
      if (e.target === lightbox) closeLightbox();
    });

    var touchStartX = 0;
    lightbox.addEventListener('touchstart', function (e) { touchStartX = e.changedTouches[0].clientX; }, { passive: true });
    lightbox.addEventListener('touchend', function (e) {
      var diff = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(diff) > 50) { if (diff > 0) showPrev(); else showNext(); }
    }, { passive: true });
  })();
</script>

<style>
  .gallery__header { margin-bottom: var(--space-8); text-align: center; }
  .gallery__meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }
  .gallery__category {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    color: #fff;
  }
  .gallery__category--co-so-vat-chat { background: var(--brand); }
  .gallery__category--hinh-anh-cac-be { background: var(--accent-strong); }
  .gallery__date {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .gallery__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--brand-ink);
    margin: 0 0 var(--space-3);
  }
  .gallery__consent {
    font-size: var(--text-sm);
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  .gallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--space-5);
  }

  .gallery__item {
    margin: 0;
    background: #fff;
    border: 1px solid var(--brand-tint);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgb(59 74 0 / 0.06);
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .gallery__item:hover {
    box-shadow: var(--shadow);
    border-color: var(--brand);
    transform: translateY(-4px);
  }

  .gallery__trigger {
    display: block;
    background: var(--brand-soft);
    border: none;
    padding: 0;
    cursor: pointer;
    width: 100%;
    min-height: var(--tap);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .gallery__trigger:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }
  .gallery__trigger img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .gallery__item:hover .gallery__trigger img { transform: scale(1.04); }

  .gallery__caption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--muted);
    text-align: center;
    margin: 0;
  }

  /* Lightbox */
  .gallery__lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(31, 38, 20, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .gallery__lightbox[hidden] { display: none; }

  .gallery__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: var(--tap);
    height: var(--tap);
    background: #fff;
    border: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }
  .gallery__close:hover { background: var(--brand-soft); color: var(--brand); transform: scale(1.06); }
  .gallery__close:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }

  .gallery__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--tap);
    height: var(--tap);
    background: #fff;
    border: none;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }
  .gallery__nav:hover { background: var(--brand-soft); color: var(--brand); }
  .gallery__nav:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .gallery__nav--prev { left: var(--space-4); }
  .gallery__nav--next { right: var(--space-4); }

  .gallery__lightbox-inner {
    max-width: 90vw;
    max-height: 85vh;
    text-align: center;
  }
  .gallery__lightbox-img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.3);
  }
  .gallery__lightbox-caption {
    margin: var(--space-3) 0 0;
    font-size: var(--text-base);
    color: #fff;
  }
  .gallery__lightbox-counter {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.8);
  }

  @media (max-width: 640px) {
    .gallery__nav--prev { left: var(--space-2); }
    .gallery__nav--next { right: var(--space-2); }
    .gallery__close { top: var(--space-2); right: var(--space-2); }
    .gallery__title { font-size: var(--text-2xl); }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__item, .gallery__trigger img, .gallery__close, .gallery__nav { transition: none; }
    .gallery__item:hover { transform: none; }
  }
</style>
