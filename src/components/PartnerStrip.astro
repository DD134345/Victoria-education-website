---
// PartnerStrip component (WEB-07b). For homepage "Đơn vị đồng hành" section (§6.6 #12).
// Logos ≤ 20 KB each, alt = partner name. Hidden until data exists.
// Grayscale logos with hover color reveal. Mobile: horizontal scroll.
import { Image } from 'astro:assets';
import partnersData from '../data/partners.json';

interface Partner {
  name: string;
  logo: string; // path to logo in assets
  url?: string;
  alt?: string;
}

interface Props {
  /** Override partners (otherwise reads from partners.json) */
  partners?: Partner[];
  /** Section heading */
  heading?: string;
  /** Section subheading */
  subheading?: string;
  /** Eyebrow label */
  eyebrow?: string;
}

const { partners: overridePartners, heading, subheading, eyebrow } = Astro.props;
const partners = (overridePartners || partnersData) as Partner[];
const showComponent = partners.length > 0;
---

{showComponent ? (
<>
  <section class="partner-strip" aria-labelledby={heading ? 'partners-heading' : undefined}>
    <div class="container">
      {(heading || subheading || eyebrow) && (
        <header class="partner-strip__header">
          {eyebrow && <p class="partner-strip__eyebrow">{eyebrow}</p>}
          {heading && <h2 id="partners-heading" class="partner-strip__heading">{heading}</h2>}
          {subheading && <p class="partner-strip__subheading">{subheading}</p>}
        </header>
      )}
      <div class="partner-strip__scroller" role="list" aria-label="Đối tác đồng hành">
        {partners.map(partner => (
          <div class="partner-strip__item" role="listitem">
            {partner.url ? (
              <a href={partner.url} target="_blank" rel="noopener noreferrer" class="partner-strip__link" aria-label={partner.alt || partner.name}>
                <Image src={partner.logo} alt={partner.alt || partner.name} loading="lazy" width={160} height={80} />
              </a>
            ) : (
              <Image src={partner.logo} alt={partner.alt || partner.name} loading="lazy" width={160} height={80} />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</>
) : null}

<style>
  .partner-strip__header { margin-bottom: var(--space-8); text-align: center; }
  .partner-strip__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    background: var(--brand-tint);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }
  .partner-strip__heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--brand-ink);
    margin-bottom: var(--space-2);
  }
  .partner-strip__subheading {
    font-size: var(--text-base);
    color: var(--muted);
    max-width: 60ch;
    margin: 0 auto;
  }

  .partner-strip__scroller {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    padding: var(--space-2) 0 var(--space-4);
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .partner-strip__scroller::-webkit-scrollbar { display: none; }
  .partner-strip__scroller { scrollbar-width: none; }

  .partner-strip__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: 160px;
  }
  @media (min-width: 768px) {
    .partner-strip__scroller {
      justify-content: center;
      overflow-x: visible;
    }
    .partner-strip__item { width: auto; }
  }

  .partner-strip__link {
    display: block;
    filter: grayscale(1) opacity(0.6);
    transition: filter 0.3s ease, transform 0.2s ease;
  }
  .partner-strip__link:hover,
  .partner-strip__link:focus-visible {
    filter: grayscale(0) opacity(1);
    transform: scale(1.05);
  }
  .partner-strip__link:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .partner-strip__item:not(:has(a)) img {
    filter: grayscale(1) opacity(0.6);
  }

  .partner-strip__item img {
    width: 100%;
    height: auto;
    max-height: 60px;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-strip__link { transition: none; }
  }
</style>