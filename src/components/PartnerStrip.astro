---
// PartnerStrip component (restyle-B). For homepage "Đơn vị đồng hành".
// Hidden until data exists (dev preview can pass demo partners).
// Mobile: horizontal scroll-snap; desktop: centred row.
import { Image } from 'astro:assets';
import partnersData from '../data/partners.json';

interface Partner {
  name: string;
  /** Logo path (public/) for owner-provided logos */
  logo?: string;
  /** Bundled logo (dev preview) */
  image?: ImageMetadata;
  url?: string;
  alt?: string;
}

interface Props {
  /** Override partners (otherwise reads from partners.json) */
  partners?: Partner[];
  /** Section heading */
  heading?: string;
  /** Section subheading */
  subheading?: string;
  /** Eyebrow label */
  eyebrow?: string;
}

const { partners: overridePartners, heading, subheading, eyebrow } = Astro.props;
const hasOwnerMarker = (v: unknown): boolean =>
  typeof v === 'string' ? v.includes('TODO-OWNER') : JSON.stringify(v).includes('TODO-OWNER');
const clean = (list: Partner[]): Partner[] =>
  list.filter((p) => p && p.name && (p.logo || p.image) && !hasOwnerMarker(p));
const partners = clean((overridePartners || partnersData) as Partner[]);
const showComponent = partners.length > 0;
---

{showComponent ? (
  <section class="partner-strip" aria-labelledby={heading ? 'partners-heading' : undefined} data-reveal>
    <div class="container">
      {(heading || subheading || eyebrow) && (
        <header class="partner-strip__header">
          {eyebrow && <p class="partner-strip__eyebrow">{eyebrow}</p>}
          {heading && <h2 id="partners-heading" class="partner-strip__heading">{heading}</h2>}
          {subheading && <p class="partner-strip__subheading">{subheading}</p>}
        </header>
      )}
      <div class="partner-strip__scroller" role="list" aria-label="Đơn vị đồng hành">
        {partners.map((partner) => (
          <div class="partner-strip__item" role="listitem">
            {partner.url ? (
              <a href={partner.url} target="_blank" rel="noopener noreferrer" class="partner-strip__link" aria-label={partner.alt || partner.name}>
                {partner.image ? (
                  <Image src={partner.image} alt={partner.alt || partner.name} loading="lazy" width={220} height={80} />
                ) : (
                  <img src={partner.logo} alt={partner.alt || partner.name} loading="lazy" width={220} height={80} />
                )}
              </a>
            ) : (
              <span class="partner-strip__static">
                {partner.image ? (
                  <Image src={partner.image} alt={partner.alt || partner.name} loading="lazy" width={220} height={80} />
                ) : (
                  <img src={partner.logo} alt={partner.alt || partner.name} loading="lazy" width={220} height={80} />
                )}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
) : null}

<style>
  .partner-strip { padding: var(--space-12) 0; }
  .partner-strip__header { margin-bottom: var(--space-8); text-align: center; }
  .partner-strip__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-ink);
    background: #fff;
    border: 1px solid var(--brand-tint);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    margin: 0 0 var(--space-3);
  }
  .partner-strip__heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--brand-ink);
    margin: 0 0 var(--space-2);
  }
  .partner-strip__subheading {
    font-size: var(--text-base);
    color: var(--muted);
    max-width: 60ch;
    margin: 0 auto;
  }

  .partner-strip__scroller {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(200px, 62vw);
    gap: var(--space-5);
    justify-content: start;
    overflow-x: auto;
    padding: var(--space-2) var(--space-1) var(--space-4);
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  @media (min-width: 768px) {
    .partner-strip__scroller { justify-content: center; }
  }

  .partner-strip__item {
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid var(--brand-tint);
    border-radius: 20px;
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 110px;
    box-shadow: 0 2px 10px rgb(59 74 0 / 0.06);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .partner-strip__item:hover { box-shadow: var(--shadow); transform: translateY(-3px); }

  .partner-strip__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    min-width: var(--tap);
    filter: grayscale(1) opacity(0.75);
    transition: filter 0.3s ease;
  }
  .partner-strip__link:hover,
  .partner-strip__link:focus-visible { filter: grayscale(0) opacity(1); }
  .partner-strip__link:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .partner-strip__static {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-strip__item img {
    width: 100%;
    height: auto;
    max-height: 64px;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-strip__link, .partner-strip__item { transition: none; }
    .partner-strip__item:hover { transform: none; }
  }
</style>
