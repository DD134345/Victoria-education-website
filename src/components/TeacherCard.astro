---
// TeacherCard component (WEB-07b). For "Giáo viên của bé" page (§6.3).
// Crops photo to 4:5 per spec §6.7. Shows: name, role, qualification, years, quote.
// Photo consent required (photo_consent: true in data).
import { Image } from 'astro:assets';
import PhotoFrame from './PhotoFrame.astro';
import { hasPhoto, teacherKey } from '../lib/photos';

interface Props {
  /** Teacher data from teachers collection */
  teacher: {
    order: number;
    name: string;
    role: string;
    qualification?: string;
    years?: number;
    quote?: string;
    photo?: string; // path to image in assets
    photo_consent: boolean;
  };
  /** Variant: 'default' | 'compact' */
  variant?: 'default' | 'compact';
}

const { teacher, variant = 'default' } = Astro.props;
// Portrait from src/assets/photos/giao-vien/<name>.jpg (only with photo consent).
const key = teacherKey(teacher.name);
const folderPhoto = teacher.photo_consent && hasPhoto(key);
---

<article class="teacher-card teacher-card--{variant}">
  {folderPhoto ? (
    <PhotoFrame photoKey={key} alt={`Giáo viên ${teacher.name}`} shape="portrait" decorate={false}
      sizes="(min-width: 1024px) 280px, 80vw" class="teacher-card__frame" />
  ) : teacher.photo && teacher.photo_consent ? (
    <div class="teacher-card__photo">
      <Image src={teacher.photo} alt={`Giáo viên ${teacher.name}`} width={320} height={400} loading="lazy" />
    </div>
  ) : import.meta.env.DEV ? (
    <PhotoFrame photoKey={key} shape="portrait" decorate={false} sizes="280px" class="teacher-card__frame" />
  ) : null}
  <div class="teacher-card__content">
    <header class="teacher-card__header">
      <h3 class="teacher-card__name">{teacher.name}</h3>
      <p class="teacher-card__role">{teacher.role}</p>
    </header>
    {teacher.qualification && (
      <p class="teacher-card__qualification">{teacher.qualification}</p>
    )}
    {teacher.years !== undefined && teacher.years > 0 && (
      <p class="teacher-card__experience">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 6v6l4 2"></path>
        </svg>
        Kinh nghiệm: {teacher.years} năm
      </p>
    )}
    {teacher.quote && (
      <blockquote class="teacher-card__quote">
        <p>"{teacher.quote}"</p>
      </blockquote>
    )}
  </div>
</article>

<style>
  .teacher-card {
    background: var(--surface);
    border: 1px solid var(--brand-tint);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .teacher-card:hover {
    box-shadow: var(--shadow);
    border-color: var(--brand);
  }
  @media (min-width: 600px) {
    .teacher-card { flex-direction: row; }
  }

  .teacher-card__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--brand-soft);
    flex-shrink: 0;
  }
  @media (min-width: 600px) {
    .teacher-card__photo { width: 200px; aspect-ratio: 4 / 5; }
  }
  .teacher-card__photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .teacher-card:hover .teacher-card__photo img { transform: scale(1.03); }

  .teacher-card__content {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .teacher-card__header { margin-bottom: var(--space-3); }
  .teacher-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--brand-ink);
    margin: 0 0 var(--space-1);
  }
  .teacher-card__role {
    font-size: var(--text-base);
    color: var(--brand);
    font-weight: 500;
    margin: 0;
  }

  .teacher-card__qualification {
    font-size: var(--text-base);
    color: var(--muted);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--brand-tint);
  }

  .teacher-card__experience {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0 0 var(--space-3);
  }
  .teacher-card__experience svg { width: 16px; height: 16px; color: var(--brand); }

  .teacher-card__quote {
    margin: 0;
    padding: var(--space-4);
    background: var(--brand-soft);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--brand);
    font-style: italic;
    color: var(--ink);
    flex: 1;
  }
  .teacher-card__quote p { margin: 0; line-height: var(--leading); }

  .teacher-card--compact .teacher-card__name { font-size: var(--text-lg); }
  .teacher-card--compact .teacher-card__content { padding: var(--space-4); }

  @media (prefers-reduced-motion: reduce) {
    .teacher-card, .teacher-card__photo img { transition: none; }
  }
</style>