---
// Header + nav (restyle-A). White sticky header with soft shadow, round logo,
// utility top bar (real contact values only), main nav below a thin green
// rule with animated underlines (active = green + underline). Mobile menu is
// the MobileNav drawer, toggled by the shared #nav-toggle checkbox (zero-JS).
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-newton-512.webp';
import { buildNav, isVisible } from '../lib/nav';
import { site, isPlaceholder } from '../lib/site';
import NavDropdown from './NavDropdown.astro';
import MobileNav from './MobileNav.astro';

const items = await buildNav();
const here = Astro.url.pathname;
const real = (v: unknown) => typeof v === 'string' && v.trim() !== '' && !isPlaceholder(v);
const hotline = real(site.hotline) ? String(site.hotline) : '';
const email = real(site.email) ? String(site.email) : '';
const telHref = hotline ? `tel:${hotline.replace(/[^\d+]/g, '')}` : '';
const ctaHref = (await isVisible('/giao-duc-tuyen-sinh/dang-ky/')) ? '/giao-duc-tuyen-sinh/dang-ky/' : '/lien-he/';
const current = (href: string) => (here === href ? 'page' : undefined);
---
<a class="skip-link" href="#main">Bỏ qua đến nội dung</a>
{(hotline || email) && (
  <div class="topbar">
    <div class="container topbar__inner">
      {email && (
        <a class="topbar__link" href={`mailto:${email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
          </svg>
          {email}
        </a>
      )}
      {hotline && (
        <a class="topbar__link topbar__link--hotline" href={telHref}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2.1L8.1 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.9 2Z"></path>
          </svg>
          Hotline: {hotline}
        </a>
      )}
    </div>
  </div>
)}
<header class="site-header">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Mở hoặc đóng menu" />
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name} – Trang chủ`}>
      <Image src={logo} alt="" width={52} height={52} loading="eager" class="brand__logo" />
      <span class="brand-name">{site.name}</span>
    </a>
    <div class="actions">
      {hotline && <a class="hotline" href={telHref}>{hotline}</a>}
      <a class="cta" href={ctaHref}>Đăng ký tham quan</a>
      <label for="nav-toggle" class="burger" aria-hidden="true"><span></span></label>
    </div>
  </div>
  <nav aria-label="Menu chính" class="nav" data-site-nav>
    <ul class="container menu">
      {items.map((item) => item.children?.length ? (
        <NavDropdown
          trigger={item.label}
          triggerHref={item.href}
          triggerCurrent={here === item.href}
          items={item.children.map((c) => ({ label: c.label, href: c.href, current: here === c.href }))}
        />
      ) : (
        <li>
          <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <MobileNav />
</header>

<style>
  .topbar { display: none; background: var(--brand-soft); border-bottom: 1px solid var(--brand-tint); }
  .topbar__inner {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
  }
  .topbar__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--brand-ink);
    text-decoration: none;
  }
  .topbar__link:hover { color: var(--brand); text-decoration: underline; }
  .topbar__link--hotline { font-weight: 700; }
  @media (min-width: 768px) {
    .topbar { display: block; }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 80;
    background: #fff;
    box-shadow: 0 2px 16px rgb(59 74 0 / 0.1);
  }
  .nav-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    margin: 0;
  }
  .nav-toggle:focus-visible ~ .bar .burger {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 76px;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .brand { display: flex; align-items: center; gap: var(--space-3); text-decoration: none; color: var(--brand-ink); min-height: var(--tap); }
  .brand__logo {
    height: 48px;
    width: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--brand-tint);
    background: #fff;
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1rem, 0.85rem + 1vw, var(--text-lg));
    line-height: 1.2;
    text-wrap: balance;
  }
  .actions { display: flex; align-items: center; gap: var(--space-3); }
  .hotline {
    display: none;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
    color: var(--brand-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .hotline:hover { color: var(--brand); }
  .cta {
    display: none;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--accent-strong);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 8px 20px rgb(201 48 58 / 0.25);
    transition: background-color 0.25s ease, transform 0.25s ease;
  }
  .cta:hover { background: var(--accent-ink); color: #fff; transform: translateY(-2px); }
  .cta:active { transform: scale(0.98); }

  .burger {
    width: var(--tap);
    height: var(--tap);
    display: grid;
    place-items: center;
    cursor: pointer;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .burger span, .burger span::before, .burger span::after {
    display: block;
    width: 24px;
    height: 3px;
    background: var(--brand-ink);
    border-radius: 2px;
    position: relative;
    transition: transform 0.25s ease, background-color 0.2s ease;
  }
  .burger span::before, .burger span::after { content: ''; position: absolute; left: 0; }
  .burger span::before { top: -8px; }
  .burger span::after { top: 8px; }
  #nav-toggle:checked ~ .bar .burger span { background: transparent; }
  #nav-toggle:checked ~ .bar .burger span::before { transform: translateY(8px) rotate(45deg); }
  #nav-toggle:checked ~ .bar .burger span::after { transform: translateY(-8px) rotate(-45deg); }

  /* Mobile: the drawer (MobileNav) is the menu; the inline nav stays hidden. */
  .nav { display: none; }

  @media (min-width: 768px) {
    .hotline { display: inline-flex; }
    .cta { display: inline-flex; }
    .brand__logo { height: 52px; width: 52px; }
  }

  @media (min-width: 1100px) {
    .burger { display: none; }
    .nav {
      display: block;
      background: #fff;
      border-top: 2px solid var(--brand);
    }
    .menu {
      list-style: none;
      margin: 0 auto;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      justify-content: center;
      gap: 0;
    }
    .menu > li { display: flex; align-items: stretch; }
    .menu > li > a {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      padding: 0 var(--space-2);
      color: var(--brand-ink);
      text-decoration: none;
      font-weight: 600;
      font-size: var(--text-sm);
      white-space: nowrap;
    }
    @media (max-width: 1320px) {
      .menu > li > a { padding: 0 6px; font-size: 0.9rem; }
    }
    .menu > li > a::after {
      content: '';
      position: absolute;
      left: var(--space-2);
      right: var(--space-2);
      bottom: 8px;
      height: 3px;
      border-radius: 2px;
      background: var(--brand);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 0.25s ease;
    }
    .menu > li > a:hover::after,
    .menu > li > a:focus-visible::after,
    .menu > li > a[aria-current='page']::after {
      transform: scaleX(1);
    }
    .menu > li > a[aria-current='page'] { color: var(--brand); }
  }

  @media (prefers-reduced-motion: reduce) {
    .burger span, .burger span::before, .burger span::after, .cta, .menu > li > a::after { transition: none; }
    .cta:hover { transform: none; }
  }
</style>
