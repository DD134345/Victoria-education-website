---
// NewsCard component (restyle-B). Rounded 22px card, photo on top, UPPERCASE
// 1-line clamped title, 3-line clamped excerpt, green pill "Xem thêm".
// Only renders approved entries (handled by published.ts filter).
import { Image } from 'astro:assets';
import { formatVnDate as formatDate } from '../lib/dates';

interface Props {
  /** News entry from getPublished('news') */
  entry: {
    data: {
      title: string;
      date: Date;
      summary?: string;
      category: 'su-kien' | 'hoc-tap' | 'dinh-duong' | 'tuyen-sinh';
      cover?: ImageMetadata;
      cover_alt?: string;
      slug: string;
    };
  };
  /** Variant: 'default' | 'compact' | 'featured' */
  variant?: 'default' | 'compact' | 'featured';
  /** Link override. Pass null to render a non-linking card (dev preview). */
  href?: string | null;
}

const { entry, variant = 'default', href } = Astro.props;
const { data } = entry;
const url = href === undefined ? `/tin-tuc/${data.slug}/` : href;
const categoryLabels: Record<string, string> = {
  'su-kien': 'Sự kiện',
  'hoc-tap': 'Học tập',
  'dinh-duong': 'Dinh dưỡng',
  'tuyen-sinh': 'Tuyển sinh',
};
const categoryVariants: Record<string, 'brand' | 'accent'> = {
  'su-kien': 'brand',
  'hoc-tap': 'accent',
  'dinh-duong': 'brand',
  'tuyen-sinh': 'accent',
};
---

<article class={`news-card news-card--${variant}`}>
  {data.cover && (
    url ? (
      <a class="news-card__cover" href={url} aria-label={`Xem chi tiết: ${data.title}`}>
        <Image src={data.cover} alt={data.cover_alt || ''} loading={variant === 'featured' ? 'eager' : 'lazy'} />
        <span class={`news-card__category news-card__category--${categoryVariants[data.category]}`}>
          {categoryLabels[data.category]}
        </span>
      </a>
    ) : (
      <div class="news-card__cover">
        <Image src={data.cover} alt={data.cover_alt || ''} loading="lazy" />
        <span class={`news-card__category news-card__category--${categoryVariants[data.category]}`}>
          {categoryLabels[data.category]}
        </span>
      </div>
    )
  )}
  <div class="news-card__content">
    {!data.cover && (
      <span class={`news-card__category news-card__category--inline news-card__category--${categoryVariants[data.category]}`}>
        {categoryLabels[data.category]}
      </span>
    )}
    <time class="news-card__date" datetime={data.date.toISOString()}>
      {formatDate(data.date)}
    </time>
    <h3 class="news-card__title">
      {url ? <a href={url}>{data.title}</a> : <span>{data.title}</span>}
    </h3>
    {data.summary && <p class="news-card__summary">{data.summary}</p>}
    {url && (
      <span class="news-card__more">
        <a class="news-card__pill" href={url} aria-label={`Xem thêm: ${data.title}`}>
          Xem thêm
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </span>
    )}
  </div>
</article>

<style>
  .news-card {
    background: #fff;
    border: 1px solid var(--brand-tint);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 2px 10px rgb(59 74 0 / 0.06);
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .news-card:hover {
    box-shadow: var(--shadow);
    border-color: var(--brand);
    transform: translateY(-4px);
  }

  .news-card__cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  div.news-card__cover { cursor: default; }
  .news-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .news-card:hover .news-card__cover img { transform: scale(1.04); }

  .news-card__category {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .news-card__category--brand { background: var(--brand); color: #fff; }
  .news-card__category--accent { background: var(--accent-strong); color: #fff; }
  .news-card__category--inline {
    position: static;
    display: inline-block;
    align-self: flex-start;
    margin-bottom: var(--space-2);
  }

  .news-card__content {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .news-card__date {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .news-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 var(--space-2);
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card__title a {
    color: var(--brand-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .news-card__title a:hover { color: var(--brand); }
  .news-card__title span { color: var(--brand-ink); }

  .news-card__summary {
    font-size: var(--text-base);
    color: var(--muted);
    line-height: var(--leading);
    flex: 1;
    margin: 0 0 var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-card__more { margin-top: auto; padding-top: var(--space-1); }
  .news-card__pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, transform 0.25s ease, gap 0.25s ease;
  }
  .news-card__pill:hover { background: var(--brand-ink); color: #fff; transform: translateY(-2px); gap: var(--space-3); }
  .news-card__pill:active { transform: scale(0.98); }
  .news-card__pill svg { width: 18px; height: 18px; flex-shrink: 0; }

  /* Compact variant: horizontal layout on desktop */
  .news-card--compact { flex-direction: row; }
  .news-card--compact .news-card__cover {
    width: 220px;
    aspect-ratio: auto;
    flex-shrink: 0;
  }
  .news-card--compact .news-card__content { padding: var(--space-4); }
  @media (max-width: 767px) {
    .news-card--compact { flex-direction: column; }
    .news-card--compact .news-card__cover { width: 100%; aspect-ratio: 16/9; }
  }

  /* Featured variant: larger, more prominent */
  .news-card--featured .news-card__title { font-size: var(--text-xl); -webkit-line-clamp: 2; }
  .news-card--featured .news-card__summary { font-size: var(--text-base); }

  @media (prefers-reduced-motion: reduce) {
    .news-card, .news-card__cover img, .news-card__title a, .news-card__pill { transition: none; }
    .news-card:hover, .news-card__pill:hover { transform: none; }
  }
</style>
