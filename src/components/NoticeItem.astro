---
// NoticeItem component (restyle-B). Rounded card with validity badge.
// Only renders approved entries. Pink accent reserved for urgency.
import { formatVnDate as formatDate } from '../lib/dates';

interface Props {
  /** Notice entry from getPublished('notices') */
  entry: {
    data: {
      title: string;
      date: Date;
      valid_until?: Date;
      summary?: string;
      slug: string;
    };
  };
  /** Variant: 'default' | 'compact' */
  variant?: 'default' | 'compact';
  /** Link override. Pass null to render a non-linking card (dev preview). */
  href?: string | null;
}

const { entry, variant = 'default', href } = Astro.props;
const { data } = entry;
const url = href === undefined ? `/thong-bao/${data.slug}/` : href;
const now = new Date();
const isValid = data.valid_until ? data.valid_until >= now : true;
---

<article class={`notice-item notice-item--${variant} notice-item--${isValid ? 'valid' : 'expired'}`}>
  <span class="notice-item__stripe" aria-hidden="true"></span>
  <header class="notice-item__header">
    <h3 class="notice-item__title">
      {url ? <a href={url}>{data.title}</a> : <span>{data.title}</span>}
    </h3>
    <div class="notice-item__meta">
      <time class="notice-item__date" datetime={data.date.toISOString()}>
        Ngày đăng: {formatDate(data.date)}
      </time>
      {data.valid_until && (
        <time class="notice-item__valid" datetime={data.valid_until.toISOString()}>
          Hiệu lực đến: {formatDate(data.valid_until)}
        </time>
      )}
      <span class={`notice-item__status notice-item__status--${isValid ? 'valid' : 'expired'}`}>
        {isValid ? 'Còn hiệu lực' : 'Hết hiệu lực'}
      </span>
    </div>
  </header>
  {data.summary && <p class="notice-item__summary">{data.summary}</p>}
  {url && (
    <footer class="notice-item__footer">
      <a class="notice-item__link" href={url} aria-label={`Xem chi tiết: ${data.title}`}>
        Xem chi tiết
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </footer>
  )}
</article>

<style>
  .notice-item {
    position: relative;
    background: #fff;
    border: 1px solid var(--brand-tint);
    border-radius: 22px;
    padding: var(--space-5) var(--space-5) var(--space-5) calc(var(--space-5) + 6px);
    overflow: hidden;
    box-shadow: 0 2px 10px rgb(59 74 0 / 0.06);
    transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .notice-item:hover {
    box-shadow: var(--shadow);
    border-color: var(--brand);
    transform: translateY(-3px);
  }
  .notice-item__stripe {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--brand);
  }
  .notice-item--expired { border-color: var(--brand-tint); }
  .notice-item--expired .notice-item__stripe { background: var(--accent-strong); }
  .notice-item--compact { padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-4) + 6px); }

  .notice-item__header { margin-bottom: var(--space-3); }
  .notice-item__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0 0 var(--space-2);
    line-height: 1.35;
  }
  .notice-item__title a {
    color: var(--brand-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .notice-item__title a:hover { color: var(--brand); }
  .notice-item__title span { color: var(--brand-ink); }
  .notice-item--compact .notice-item__title { font-size: var(--text-base); }

  .notice-item__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }
  .notice-item__date { color: var(--muted); }
  .notice-item__valid { color: var(--muted); }

  .notice-item__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .notice-item__status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .notice-item__status--valid {
    color: var(--brand-ink);
    background: var(--brand-soft);
  }
  .notice-item__status--valid::before { background: var(--brand); }
  .notice-item__status--expired {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }
  .notice-item__status--expired::before { background: var(--accent-strong); }

  .notice-item__summary {
    font-size: var(--text-base);
    color: var(--ink);
    line-height: var(--leading);
    margin: 0 0 var(--space-3);
  }

  .notice-item__footer { padding-top: var(--space-3); border-top: 1px solid var(--brand-tint); }
  .notice-item__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--accent-strong);
    text-decoration: none;
    transition: color 0.2s ease, gap 0.2s ease;
  }
  .notice-item__link:hover { color: var(--accent-ink); gap: var(--space-3); }
  .notice-item__link svg { width: 18px; height: 18px; flex-shrink: 0; }

  @media (prefers-reduced-motion: reduce) {
    .notice-item, .notice-item__title a, .notice-item__link { transition: none; }
    .notice-item:hover { transform: none; }
  }
</style>
