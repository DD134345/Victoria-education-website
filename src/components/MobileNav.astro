---
// MobileNav (restyle-A). Slide-in drawer for viewports below 1100px.
// Zero-JS open/close: controlled by the shared #nav-toggle checkbox rendered
// in Header.astro (this component must be a later sibling of that checkbox
// inside the same <header>). Submenus render expanded (indented) so touch
// users need no toggle. A tiny inline script only locks body scroll and
// handles Escape; the menu works fully without JS.
import { buildNav, isVisible } from '../lib/nav';
import { site, isPlaceholder } from '../lib/site';

const items = await buildNav();
const here = Astro.url.pathname;
const current = (href: string) => (here === href ? 'page' : undefined);
const real = (v: unknown) => typeof v === 'string' && v.trim() !== '' && !isPlaceholder(v);
const hotline = real(site.hotline) ? String(site.hotline) : '';
const telHref = hotline ? `tel:${hotline.replace(/[^\d+]/g, '')}` : '';
const ctaHref = (await isVisible('/giao-duc-tuyen-sinh/dang-ky/')) ? '/giao-duc-tuyen-sinh/dang-ky/' : '/lien-he/';
---

<label class="mobile-nav__overlay" for="nav-toggle" aria-hidden="true"></label>
<nav id="mobile-nav" class="mobile-nav" aria-label="Menu di động">
  <div class="mobile-nav__head">
    <span class="mobile-nav__title">Menu</span>
    <label class="mobile-nav__close" for="nav-toggle" aria-label="Đóng menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="24" height="24" aria-hidden="true" focusable="false">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </label>
  </div>
  <ul class="mobile-nav__list">
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={current(item.href)} class="mobile-nav__link">
          {item.label}
        </a>
        {item.children && (
          <ul class="mobile-nav__sub">
            {item.children.map((c) => (
              <li><a href={c.href} aria-current={current(c.href)} class="mobile-nav__sub-link">{c.label}</a></li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  <div class="mobile-nav__foot">
    {hotline && <a class="mobile-nav__btn mobile-nav__btn--outline" href={telHref}>Gọi: {hotline}</a>}
    <a class="mobile-nav__btn mobile-nav__btn--pink" href={ctaHref}>Đăng ký tham quan</a>
  </div>
</nav>

<script is:inline>(function(){try{var t=document.getElementById('nav-toggle');if(!t)return;t.addEventListener('change',function(){document.body.style.overflow=t.checked?'hidden':'';});document.addEventListener('keydown',function(e){if(e.key==='Escape'&&t.checked){t.checked=false;document.body.style.overflow='';}});}catch(e){}})();</script>

<style>
  .mobile-nav__overlay {
    position: fixed;
    inset: 0;
    background: rgb(31 38 20 / 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 90;
    cursor: pointer;
  }
  #nav-toggle:checked ~ .mobile-nav__overlay {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 340px);
    background: var(--surface);
    box-shadow: var(--shadow);
    visibility: hidden;
    transform: translateX(102%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.32s;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  #nav-toggle:checked ~ .mobile-nav {
    visibility: visible;
    transform: translateX(0);
  }
  @media (min-width: 1100px) {
    .mobile-nav, .mobile-nav__overlay { display: none; }
  }

  .mobile-nav__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--brand);
    border-bottom: 3px solid var(--brand-ink);
  }
  .mobile-nav__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: #fff;
  }
  .mobile-nav__close {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    color: #fff;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }
  .mobile-nav__close:hover { background: var(--brand-ink); }

  .mobile-nav__list {
    list-style: none;
    margin: 0;
    padding: var(--space-3) var(--space-5);
    flex: 1;
  }
  .mobile-nav__link {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: var(--space-2) 0;
    color: var(--brand-ink);
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    border-bottom: 1px solid var(--brand-tint);
  }
  .mobile-nav__link:hover,
  .mobile-nav__link[aria-current='page'] { color: var(--brand); }

  .mobile-nav__sub {
    list-style: none;
    margin: var(--space-1) 0 var(--space-2);
    padding: 0 0 0 var(--space-4);
    border-left: 3px solid var(--brand-tint);
    display: grid;
    gap: 0;
  }
  .mobile-nav__sub-link {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-base);
  }
  .mobile-nav__sub-link:hover,
  .mobile-nav__sub-link[aria-current='page'] { color: var(--brand); font-weight: 600; }

  .mobile-nav__foot {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5) var(--space-6);
    border-top: 1px solid var(--brand-tint);
    background: #fff;
  }
  .mobile-nav__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }
  .mobile-nav__btn:active { transform: scale(0.98); }
  .mobile-nav__btn--pink { background: var(--accent-strong); color: #fff; }
  .mobile-nav__btn--pink:hover { background: var(--accent-ink); color: #fff; }
  .mobile-nav__btn--outline { background: #fff; color: var(--brand-ink); border: 2px solid var(--brand); }
  .mobile-nav__btn--outline:hover { background: var(--brand); color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav, .mobile-nav__overlay, .mobile-nav__close, .mobile-nav__btn { transition: none; }
  }
</style>
