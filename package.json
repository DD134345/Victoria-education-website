{
  "name": "victoria-education-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-exif.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "verify": "astro check && npm run build && node scripts/verify-approval.mjs && node scripts/verify-seo.mjs && node scripts/verify-libs.mjs && node scripts/verify-routes.mjs && node scripts/verify-contrast.mjs && node scripts/verify-demo.mjs && node scripts/verify-exif.mjs",
    "verify:approval": "node scripts/verify-approval.mjs",
    "verify:libs": "node scripts/verify-libs.mjs",
    "photos:shotlist": "node scripts/import-photos.mjs shotlist",
    "photos:import": "node scripts/import-photos.mjs import",
    "photos:apply": "node scripts/import-photos.mjs import --apply"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "astro": "^7.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
